*.swo

# Environment & Secrets (Every single env variant strictly ignored)
.env
.env.*
.env*.local
*.env
*.env.*
*.env.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Preserve only the clean example template
!.env.example

